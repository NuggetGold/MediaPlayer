<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundBrush" Color="#0E0F13" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1E26" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#171A21" />
    <SolidColorBrush x:Key="HoverBrush" Color="#232733" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#2A2E3C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2A2F3A" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA3B2" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="Accent1Brush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#22D3EE" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />

    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#171A22" Offset="0" />
        <GradientStop Color="#101218" Offset="0.55" />
        <GradientStop Color="#0E0F13" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8B5CF6" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VolumeGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#22D3EE" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1F2431" Offset="0" />
        <GradientStop Color="#151822" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardScrimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C20B0C10" Offset="0" />
        <GradientStop Color="#D90B0C10" Offset="0.5" />
        <GradientStop Color="#F20B0C10" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CoverPlaceholderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#313749" Offset="0" />
        <GradientStop Color="#1B1E26" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
