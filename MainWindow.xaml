<Window x:Class="MediaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медиаплеер"
        Width="1180"
        Height="770"
        MinWidth="940"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0E0F13"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Opacity="0"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="TrackTemplate">
            <Grid Margin="10,9" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="CurrentMark"
                        Grid.Column="0"
                        Width="3"
                        CornerRadius="2"
                        Background="{StaticResource AccentGradientBrush}"
                        Opacity="0"
                        Margin="0,1,9,1" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="{Binding Title}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding ArtistDisplay}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding DurationDisplay}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           Typography.NumeralAlignment="Tabular" />
                <Button Grid.Column="3"
                        Style="{StaticResource IconButtonStyle}"
                        Width="30"
                        Height="30"
                        FontSize="12"
                        Content="&#xE74D;"
                        Margin="8,0,0,0"
                        Opacity="0.35"
                        ToolTip="Удалить из списка"
                        Click="DeleteTrack_Click" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="CurrentMark" Property="Opacity" Value="1" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource Accent2Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="CurrentMark" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="#2A2F3A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootSlide" Y="0" />
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentGradientBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="Медиаплеер" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}" Content="&#xE921;" ToolTip="Свернуть" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}" Content="&#xE922;" ToolTip="Развернуть" Click="Maximize_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" ToolTip="Закрыть" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="360" />
                    <ColumnDefinition Width="3*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="14" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Margin="16,0,8,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,18,18,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Плейлист" FontSize="18" FontWeight="Bold" />
                                <TextBlock x:Name="CountText" Text="Пусто" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="38"
                                    Height="38"
                                    FontSize="15"
                                    Content="&#xE74D;"
                                    ToolTip="Очистить список"
                                    VerticalAlignment="Top"
                                    Click="Clear_Click" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="18,0,18,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0" Click="AddFiles_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE710;" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Добавить файлы" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Margin="6,0,0,0" Click="AddFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8B7;" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Добавить папку" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2" Margin="18,0,18,10">
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}" TextChanged="SearchBox_TextChanged" />
                            <StackPanel x:Name="SearchHintPanel" Orientation="Horizontal" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE721;" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Поиск по плейлисту" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3" Margin="11,0,11,0">
                            <ListBox x:Name="TrackList" Style="{StaticResource PlaylistListStyle}" ItemTemplate="{StaticResource TrackTemplate}" MouseDoubleClick="TrackList_MouseDoubleClick" />
                            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" Margin="0,0,0,20">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D6;" FontSize="40" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock x:Name="EmptyStateText" Text="Список пуст" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="EmptyStateHint" Text="Добавьте файлы или перетащите их в окно" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="270" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="StatusText"
                                   Grid.Row="4"
                                   Margin="19,10,18,16"
                                   Text="Перетащите аудиофайлы или папки сюда"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="8,0,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="16" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,18">
                        <Grid>
                            <Border CornerRadius="15" Background="{StaticResource CardGradientBrush}" />
                            <Border x:Name="CoverBackdrop" CornerRadius="15" Opacity="0.34" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="BackdropBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                </Border.Background>
                                <Border.Effect>
                                    <BlurEffect Radius="50" KernelType="Gaussian" />
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="15" Background="{StaticResource CardScrimBrush}" />
                            <Grid x:Name="NowPlayingContent" Margin="30">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                                    <Grid Width="214" Height="214" HorizontalAlignment="Center">
                                        <Border x:Name="CoverPlaceholder" CornerRadius="16" Background="{StaticResource CoverPlaceholderBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D6;" FontSize="64" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="CoverFrame" CornerRadius="16" Visibility="Collapsed" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                            <Border.Background>
                                                <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="NowTitleText"
                                               Text="Ничего не играет"
                                               FontSize="23"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,24,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="NowArtistText"
                                               Text="Выберите трек из плейлиста"
                                               FontSize="14"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,7,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="6,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurrentTimeText"
                                   Grid.Column="0"
                                   Text="0:00"
                                   FontSize="12"
                                   Width="46"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Typography.NumeralAlignment="Tabular" />
                        <Slider x:Name="SeekSlider"
                                Grid.Column="1"
                                Margin="10,0"
                                Style="{StaticResource SeekSliderStyle}"
                                Minimum="0"
                                Maximum="1"
                                Value="0"
                                IsEnabled="False"
                                ValueChanged="SeekSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                LostMouseCapture="SeekSlider_LostMouseCapture" />
                        <TextBlock x:Name="TotalTimeText"
                                   Grid.Column="2"
                                   Text="0:00"
                                   FontSize="12"
                                   Width="46"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,8,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ToggleButton x:Name="ShuffleButton"
                                          Style="{StaticResource TransportToggleStyle}"
                                          Content="&#xE8B1;"
                                          ToolTip="Перемешать"
                                          Click="Shuffle_Click" />
                            <Button x:Name="PreviousButton"
                                    Style="{StaticResource TransportButtonStyle}"
                                    Content="&#xE892;"
                                    ToolTip="Предыдущий трек"
                                    Click="Previous_Click" />
                            <Button x:Name="PlayButton"
                                    Style="{StaticResource PlayButtonStyle}"
                                    Content="&#xE768;"
                                    ToolTip="Воспроизведение"
                                    Click="PlayPause_Click">
                                <Button.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="30" ShadowDepth="0" Opacity="0" />
                                </Button.Effect>
                            </Button>
                            <Button x:Name="StopButton"
                                    Style="{StaticResource TransportButtonStyle}"
                                    Content="&#xE71A;"
                                    ToolTip="Стоп"
                                    Click="Stop_Click" />
                            <Button x:Name="NextButton"
                                    Style="{StaticResource TransportButtonStyle}"
                                    Content="&#xE893;"
                                    ToolTip="Следующий трек"
                                    Click="Next_Click" />
                            <ToggleButton x:Name="RepeatButton"
                                          Style="{StaticResource TransportToggleStyle}"
                                          Content="&#xE8EE;"
                                          ToolTip="Повтор"
                                          Click="Repeat_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="6,0,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE767;"
                                   FontSize="15"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Slider x:Name="VolumeSlider"
                                Grid.Column="1"
                                Margin="12,0"
                                Style="{StaticResource VolumeSliderStyle}"
                                Minimum="0"
                                Maximum="1"
                                Value="0"
                                ToolTip="Громкость"
                                ValueChanged="VolumeSlider_ValueChanged" />
                        <TextBlock x:Name="VolumeText"
                                   Grid.Column="2"
                                   Text="80%"
                                   FontSize="12"
                                   Width="46"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>
                </Grid>
            </Grid>

            <Border x:Name="DropOverlay"
                    Grid.RowSpan="2"
                    Margin="16"
                    CornerRadius="18"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Background="#E60E0F13">
                <Grid>
                    <Rectangle Stroke="{StaticResource Accent2Brush}" StrokeThickness="2" StrokeDashArray="4 3" RadiusX="16" RadiusY="16" Margin="6" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="44" HorizontalAlignment="Center" Foreground="{StaticResource Accent2Brush}" />
                        <TextBlock Text="Отпустите, чтобы добавить в плейлист" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="BannerBorder"
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0"
                    MaxWidth="660"
                    Visibility="Collapsed"
                    Opacity="0"
                    CornerRadius="12"
                    Background="#F21B1E26"
                    BorderBrush="{StaticResource ErrorBrush}"
                    BorderThickness="1"
                    Padding="16,12">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="3" Opacity="0.55" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BannerSlide" Y="-18" />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BannerIcon"
                               FontFamily="Segoe MDL2 Assets"
                               Text="&#xE7BA;"
                               FontSize="16"
                               Foreground="{StaticResource ErrorBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <TextBlock x:Name="BannerText"
                               Text=""
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Width="28"
                            Height="28"
                            FontSize="12"
                            Content="&#xE711;"
                            Margin="14,0,0,0"
                            ToolTip="Скрыть"
                            Click="BannerClose_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
